    "SimpleEqualizer(音声を加工していません)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimpleEqualizer (not processing audio)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SimpleEqualizer(音声を加工していません)"
          }
        }
      }
    },
    "macOS の音量で変える出力先で、イコライザーで上げているときに働きます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Works on outputs whose volume is set with the macOS volume, when the equalizer boosts any band."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS の音量で変える出力先で、イコライザーで上げているときに働きます。"
          }
        }
      }
    },
    "「%@」の加工を始められませんでした。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t start processing “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の加工を始められませんでした。"
          }
        }
      }
    },
    "「%@」は、対応していない出力先です。%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” isn’t a supported output. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "「%1$@」は、対応していない出力先です。%2$@"
          }
        }
      }
    },
    "「%@」への変更を保存していません" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes to “%@” haven’t been saved"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」への変更を保存していません"
          }
        }
      }
    },
    "「%@」を、すべて 0 dB で上書きしますか?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overwrite “%@” with all bands at 0 dB?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を、すべて 0 dB で上書きしますか?"
          }
        }

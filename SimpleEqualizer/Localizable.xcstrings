    },
    "「%@」を削除しますか?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete “%@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除しますか?"
          }
        }
      }
    },
    "いまの一覧は、アプリを終えるまでは使えます。終了のときに、もう一度保存を試します。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep using the current list until you quit the app. The app will try to save again when it quits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまの一覧は、アプリを終えるまでは使えます。終了のときに、もう一度保存を試します。"
          }
        }
      }
    },
    "いまの出力先" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current output"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまの出力先"
          }
        }
      }
    },
    "いまは、上げているバンドがないので、下げていません。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not lowering the volume, because no band is boosted right now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまは、上げているバンドがないので、下げていません。"
          }
